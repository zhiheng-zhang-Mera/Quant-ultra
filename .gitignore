# ---------------------------------------------------------------------------
# Quant-Ultra .gitignore
# Only runtime/test source code and documentation are synced. Every file or
# folder generated by running the pipeline (caches, logs, phase results,
# reports, compiled artifacts, ML model dumps) stays local.
# ---------------------------------------------------------------------------

# --- Python / build ---
__pycache__/
*.py[cod]
*.pyd
*.so
*.c
build/
dist/
*.egg-info/
*.h5
*.joblib
*.pkl
*.npz

# --- virtualenvs / local env ---
.venv*/
venv/

# --- pytest / IDE-local ---
.pytest_cache/
*pytest_tmp*/
.tmp_*/
.coverage
htmlcov/
.idea/
*.swp

# --- runtime logs ---
*.log
*.jsonl

# --- runtime data / intermediate results ---
*.parquet
*.feather
*.csv
data/
Quant-4/data_cache/
Quant-4/Data_Cache/
Quant-4/Phase_Result/
Quant-4/Phase Result/
Quant-4/logs/
Quant-4/reports/
Quant-4/.tmp/
Quant-4/benchmark/*.json

# --- repository-root local diagnostics / model-catalog scratch ---
/_bin_catalog_chunk.txt
/_fix_dryrun/
/_recon_8_10.py
/fix_approval_model*.py
/models_catalog_addon.json*

# --- Cython generated C ---
Quant-4/cython/*.c
